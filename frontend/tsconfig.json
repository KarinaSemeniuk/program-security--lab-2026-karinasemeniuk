{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "#ui-domain/*": ["src/Domain/*"],
      "#ui-application/*": ["src/Application/*"],
      "#ui-infrastructure/*": ["src/Infrastructure/*"],
      "#ui-entrypoint/*": ["src/EntryPoint/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
