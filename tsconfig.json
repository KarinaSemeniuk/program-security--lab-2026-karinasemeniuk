{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "#domain/*": [
        "src/Domain/*"
      ],
      "#application/*": [
        "src/Application/*"
      ],
      "#infrastructure/*": [
        "src/Infrastructure/*"
      ],
      "#entrypoint/*": [
        "src/EntryPoint/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
